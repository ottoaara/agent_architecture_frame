# Model provider: anthropic | ollama | mock
AGENT_FACTORY_PROVIDER=mock
AGENT_FACTORY_MODEL=claude-opus-5-5
AGENT_FACTORY_EFFORT=medium
# Required when provider=anthropic (or use `ant auth login`)
ANTHROPIC_API_KEY=
# Used when provider=ollama
OLLAMA_MODEL=qwen3.8
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local storage root (SQLite DB, run artifacts, tool workspace)
AGENT_FACTORY_DATA_DIR=var
# API location used by the Streamlit UI
AGENT_FACTORY_API_URL=http://127.0.0.1:8000
